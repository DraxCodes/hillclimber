@* AI Elements: TraceLine (base primitive).

   A single row: icon, title, optional description. `Status` drives the official
   data-status styling: error turns the row destructive, pending dims it, running
   shimmers the title. *@
<span data-slot="trace-line"
      data-status="@Status"
      class="@UiClass.Join(
          "flex w-fit max-w-full min-w-0 items-center gap-2 text-sm text-muted-foreground transition-colors",
          "in-[a,button]:cursor-pointer in-[a:hover,button:hover]:text-foreground",
          "data-[status=error]:text-destructive data-[status=error]:in-[a:hover,button:hover]:text-destructive",
          "data-[status=pending]:opacity-60",
          "data-[status=running]:*:data-[slot=trace-title]:shimmer",
          Class)">
    @ChildContent
</span>

@code {
    /// <summary>running, error, pending, or null for a settled row.</summary>
    [Parameter] public string? Status { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}