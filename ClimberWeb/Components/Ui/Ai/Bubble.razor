@* AI Elements: Bubble (+ BubbleContent).

   The registry splits the variant onto the wrapper and reads it from the content
   through `*:data-[slot=bubble-content]` selectors. Rendering both elements here
   keeps one source of truth for the surface, and the class names match the
   registry's. *@
<div data-slot="bubble"
     data-variant="@Variant"
     data-align="@Align"
     class="@UiClass.Join(
         "group/bubble relative flex w-fit max-w-[80%] min-w-0 flex-col gap-1",
         "group-data-[align=end]/message:self-end data-[align=end]:self-end",
         "data-[variant=ghost]:max-w-full",
         Class)">
    <div data-slot="bubble-content"
         class="@UiClass.Join(
             "w-fit max-w-full min-w-0 overflow-hidden rounded-3xl border border-transparent px-3 py-2.5 text-sm leading-relaxed wrap-break-word",
             "group-data-[align=end]/bubble:self-end",
             "[button,a]:transition-colors [button,a]:outline-none [button,a]:focus-visible:border-ring [button,a]:focus-visible:ring-3 [button,a]:focus-visible:ring-ring/30",
             SurfaceClass)">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>default, secondary, muted, outline or ghost.</summary>
    [Parameter] public string Variant { get; set; } = "default";

    /// <summary>start or end; end aligns the bubble under a person's message.</summary>
    [Parameter] public string Align { get; set; } = "start";

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string SurfaceClass => Variant switch
    {
        "secondary" => "bg-secondary text-secondary-foreground",
        "muted" => "bg-muted",
        "outline" => "border-border bg-background",
        "ghost" => "rounded-none bg-transparent p-0",
        "destructive" => "bg-destructive/10 text-destructive",
        _ => "bg-primary text-primary-foreground",
    };
}