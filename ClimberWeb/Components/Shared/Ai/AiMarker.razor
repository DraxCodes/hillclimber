<div class="ai-marker @ToneClass">@Text</div>

@code {
    /// <summary>A dim step boundary or summary.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public MarkerTone Tone { get; set; }

    private string ToneClass => Tone == MarkerTone.Error ? "ai-marker-error" : string.Empty;
}