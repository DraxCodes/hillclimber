<details class="ai-turn @StatusClass" open="@Open">
    <summary class="ai-turn-head">
        <span class="ai-turn-summary">@Summary</span>
        <AiIcon Name="chevron" CssClass="ai-chevron" />
    </summary>
    <div class="ai-turn-body">
        @ChildContent
        @if (!string.IsNullOrEmpty(Footer))
        {
            <div class="ai-turn-foot">@Footer</div>
        }
    </div>
</details>

@code {
    /// <summary>The one-line label, for example "Worked in 3 steps · 1 failed".</summary>
    [Parameter, EditorRequired]
    public string Summary { get; set; } = string.Empty;

    /// <summary>The turn's display state; a failure or a running turn opens it.</summary>
    [Parameter]
    public StepStatus Status { get; set; }

    /// <summary>Whether the turn starts expanded.</summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>The cost/token footer line, shown at the end of the body.</summary>
    [Parameter]
    public string? Footer { get; set; }

    /// <summary>The turn's reasoning and trace rows, in chronological order.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string StatusClass => Status switch
    {
        StepStatus.Running => "ai-status-running",
        StepStatus.Failed => "ai-status-error",
        _ => string.Empty,
    };
}