@using ClimberWeb.Services

@if (Detail is not null)
{
    <details class="ai-trace-line @StatusClass" open="@(Status == TraceStatus.Failed)">
        <summary class="ai-trace-row">
            <AiIcon Name="@Icon" />
            <span class="ai-trace-title">@Title</span>
            @if (!string.IsNullOrEmpty(Description))
            {
                <span class="ai-trace-desc">@Description</span>
            }
            <AiIcon Name="chevron" CssClass="ai-chevron" />
        </summary>
        <div class="ai-trace-detail">
            <AiCodeBlock Text="@Detail" />
        </div>
    </details>
}
else
{
    <div class="ai-trace-line @StatusClass">
        <span class="ai-trace-row">
            <AiIcon Name="@Icon" />
            <span class="ai-trace-title">@Title</span>
            @if (!string.IsNullOrEmpty(Description))
            {
                <span class="ai-trace-desc">@Description</span>
            }
        </span>
    </div>
}

@code {
    /// <summary>One of: terminal, file, pencil, search, globe, subagent, gear.</summary>
    [Parameter, EditorRequired]
    public string Icon { get; set; } = "gear";

    /// <summary>The one-line label, for example "Ran dotnet test".</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Optional secondary text.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>The step's display state; a failure opens its detail.</summary>
    [Parameter]
    public TraceStatus Status { get; set; }

    /// <summary>Expandable output. Null renders a plain row with no disclosure.</summary>
    [Parameter]
    public string? Detail { get; set; }

    private string StatusClass => Status switch
    {
        TraceStatus.Running => "ai-status-running",
        TraceStatus.Failed => "ai-status-error",
        _ => string.Empty,
    };
}