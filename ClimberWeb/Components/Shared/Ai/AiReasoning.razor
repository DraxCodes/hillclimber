<details class="ai-reasoning" open="@Open">
    <summary class="ai-reasoning-head">
        <AiIcon Name="subagent" CssClass="ai-reasoning-icon" />
        <span class="ai-reasoning-label">Thought</span>
        <AiIcon Name="chevron" CssClass="ai-chevron" />
    </summary>
    <div class="ai-reasoning-body">
        <AiMarkdown Text="@Text" />
    </div>
</details>

@code {
    /// <summary>The model's reasoning, rendered as markdown.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>Whether the reasoning starts expanded. The newest turn opens it.</summary>
    [Parameter]
    public bool Open { get; set; }
}