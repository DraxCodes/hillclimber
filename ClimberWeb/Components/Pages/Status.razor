@page "/status"
@inject IProjectStatusService ProjectStatus

<PageTitle>status · hillclimber</PageTitle>

<AuthGate OnUnlocked="LoadAsync">
<div class="mx-auto flex w-full max-w-5xl flex-col gap-4 px-3 py-4 sm:px-4">
@if (_report is null)
{
    <PagePanel Index="0" Title="status">
        <Spinner>Reading the repository…</Spinner>
    </PagePanel>
}
else
{
    <p class="max-w-prose text-sm text-muted-foreground">Project health and history for this repository — read-only.</p>

    @foreach (var warning in _report.Warnings)
    {
        <Alert Tone="info" Icon="circle-alert">@warning</Alert>
    }

    <dl class="telemetry mb-0" aria-label="Repository">
        <div class="cell">
            <dt>branch</dt>
            <dd class="sm">@(_report.Repo?.Branch ?? "—")</dd>
        </div>
        <div class="cell">
            <dt>head</dt>
            <dd class="sm mono">@(_report.Repo?.Head ?? "—")</dd>
        </div>
        <div class="cell">
            <dt>tree</dt>
            <dd class="sm">
                @if (_report.Repo is null)
                {
                    <span class="dim">—</span>
                }
                else if (_report.Repo.Dirty)
                {
                    <span class="r">dirty</span>
                }
                else
                {
                    <span class="g">clean</span>
                }
            </dd>
        </div>
        <div class="cell">
            <dt>commits</dt>
            <dd class="sm">@_report.Changes.Count</dd>
        </div>
    </dl>

    <PagePanel Index="1" Title="changelog" Meta="@($"{_report.Changes.Count} changes")" Flush>
        @if (_report.Changes.Count == 0)
        {
            <p class="px-4 py-3.5 font-mono text-[0.78rem] text-muted-foreground sm:px-5">No history to show.</p>
        }
        else
        {
            <ol class="changes">
                @foreach (var change in _report.Changes)
                {
                    <li class="change">
                        <span class="change-hash mono" title="@change.RawSubject">@change.Hash</span>
                        <span class="change-desc" title="@change.RawSubject">@change.Description</span>
                        @if (!change.Authored)
                        {
                            <span class="change-src dim" title="Derived from the commit subject">auto</span>
                        }
                        <time class="change-when dim">@WhenLabel(change.When)</time>
                    </li>
                }
            </ol>
        }
    </PagePanel>

    <PagePanel Index="2" Title="coverage &amp; tests" Meta="@(_report.Coverage?.Generated is { } generated ? WhenLabel(generated) : null)">
        @if (_report.Coverage is not { } coverage)
        {
            <p class="font-mono text-[0.78rem] leading-relaxed text-muted-foreground">
                Not measured yet. Run <code class="mono">scripts/status.ps1</code> to write
                <code class="mono">status/coverage.json</code>.
            </p>
        }
        else
        {
            <div class="cov-row">
                <div class="cov-stat">
                    <span class="cov-num">@coverage.Passed<span class="dim">/@coverage.Total</span></span>
                    <span class="cov-lbl">tests passing</span>
                </div>
                <div class="cov-stat">
                    <span class="cov-num @(coverage.Passing ? "g" : "r")">@coverage.Failed</span>
                    <span class="cov-lbl">failing</span>
                </div>
                <div class="cov-stat">
                    <span class="cov-num">@(coverage.LinePercent is int percent ? $"{percent}%" : "—")</span>
                    <span class="cov-lbl">line coverage</span>
                </div>
            </div>
            @if (coverage.LinePercent is int linePercent)
            {
                <div class="meter" role="img" aria-label="@($"{linePercent}% line coverage")">
                    <span class="meter-fill" style="@($"width: {linePercent}%")"></span>
                </div>
            }
        }
    </PagePanel>

    <PagePanel Index="3" Title="iteration cadence" Meta="@($"commits per {(_report.CadenceUnit == CadenceUnit.Hour ? "hour" : "day")}")">
        @if (_report.Cadence.Count == 0)
        {
            <p class="font-mono text-[0.78rem] text-muted-foreground">No commits to plot.</p>
        }
        else
        {
            <div class="chart">
                <svg viewBox="@($"0 0 {ChartWidth} {ChartHeight}")"
                     width="@ChartWidth" height="@ChartHeight"
                     preserveAspectRatio="xMidYMid meet"
                     role="img"
                     aria-label="@CadenceLabel">
                    <line class="axis" x1="0" y1="@Baseline" x2="@ChartWidth" y2="@Baseline" />
                    @for (var i = 0; i < _report.Cadence.Count; i++)
                    {
                        var bucket = _report.Cadence[i];
                        var barHeight = CadenceMax == 0 ? 0 : (double)bucket.Count / CadenceMax * (Baseline - TopPad);
                        var x = i * Step + BarGap;
                        var y = Baseline - barHeight;
                        <g class="bar-group">
                            <title>@($"{bucket.Label}: {bucket.Count} commit{(bucket.Count == 1 ? "" : "s")}")</title>
                            <rect class="bar" x="@x" y="@y" width="@BarWidth" height="@barHeight" rx="2" />
                        </g>
                    }
                </svg>
                <div class="chart-labels" style="@($"width: {ChartWidth}px")">
                    @for (var i = 0; i < _report.Cadence.Count; i++)
                    {
                        <span class="chart-tick" style="@($"width: {Step}px")">@(ShowLabel(i) ? _report.Cadence[i].Label : string.Empty)</span>
                    }
                </div>
            </div>
        }
    </PagePanel>

    <PagePanel Index="4" Title="tracked issues" Meta="@($"{_report.Issues.Count} open")">
        @if (_report.Issues.Count == 0)
        {
            <p class="font-mono text-[0.78rem] text-muted-foreground">Nothing tracked and unstarted.</p>
        }
        else
        {
            <ul class="issues">
                @foreach (var issue in _report.Issues)
                {
                    <li class="issue">
                        <span class="issue-num mono">@issue.Number.ToString("00")</span>
                        <span class="issue-title">@issue.Title</span>
                        <Badge Variant="outline" Class="font-mono">@issue.Feature</Badge>
                        <span class="issue-status">@issue.Status</span>
                    </li>
                }
            </ul>
        }
    </PagePanel>

    <PagePanel Index="5" Title="models &amp; workflow" Meta="@($"{_report.Workflow.Roles.Count} agents")">
        <div class="model-row flex-wrap">
            <span class="label model-label">base model</span>
            <Badge Variant="outline" Class="font-mono">@_report.Workflow.BaseModel</Badge>
        </div>

        <p class="workflow-text">@_report.Workflow.BaseWorkflow</p>
        <p class="workflow-text dim">@WorkflowCatalogReader.HillclimbWorkflow</p>

        @if (_report.Workflow.Roles.Count > 0)
        {
            <ul class="roles">
                @foreach (var role in _report.Workflow.Roles)
                {
                    <li class="role">
                        <span class="role-name mono">@role.Name</span>
                        @if (role.ReadOnly)
                        {
                            <span class="chip role-tag">read-only</span>
                        }
                        <span class="role-desc">@role.Description</span>
                        @if (!string.IsNullOrEmpty(role.Model))
                        {
                            <span class="role-model mono dim">@role.Model</span>
                        }
                    </li>
                }
            </ul>
        }

        <p class="mt-3 text-[0.74rem] leading-relaxed text-muted-foreground">
            Per-change model is the base default. git records no model per commit, so it is not fabricated here.
        </p>
    </PagePanel>
}
</div>
</AuthGate>

@code {
    private const int BarWidth = 22;
    private const int Step = 34;
    private const int BarGap = 3;
    private const int TopPad = 8;
    private const int Baseline = 96;
    private const int ChartHeight = 104;

    private StatusReport? _report;

    private int ChartWidth => Math.Max(1, (_report?.Cadence.Count ?? 0) * Step + BarGap * 2);

    private int CadenceMax => _report?.Cadence.Count > 0 ? _report.Cadence.Max(b => b.Count) : 0;

    private string CadenceLabel =>
        $"Commit cadence: {_report?.Cadence.Sum(b => b.Count) ?? 0} commits across {_report?.Cadence.Count ?? 0} buckets";

    private async Task LoadAsync()
    {
        _report = await ProjectStatus.GetStatusAsync();
    }

    private bool ShowLabel(int index)
    {
        var total = _report?.Cadence.Count ?? 0;
        var every = Math.Max(1, (int)Math.Ceiling(total / 8d));
        return index % every == 0 || index == total - 1;
    }

    private static string WhenLabel(DateTimeOffset when) =>
        when == DateTimeOffset.MinValue
            ? "—"
            : when.ToLocalTime().ToString("MMM d, HH:mm", System.Globalization.CultureInfo.InvariantCulture);
}
