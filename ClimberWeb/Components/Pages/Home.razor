    /// and collapses once the turn settles.
    /// </param>
    private RenderFragment Row(LogEntry entry, bool live) => @<text>
        @if (entry.Kind == LogKind.Reasoning)
        {
            <AiReasoning @key="entry.Raw" Text="@entry.Text" Running="@live" />
        }
        else if (entry.Kind == LogKind.Subagent && _outputTab != PrimaryTab)
        {
            // On its own tab a delegate is one Task: the brief it was handed and what it
            // returned. Its state leads the row through the status icon.
            <AiTask @key="entry.Raw"
                    Title="@AgentName(entry)"
                    Steps="Array.Empty<PlanStep>()"
                    Running="@(entry.Status == StepStatus.Running)">
                <Extra>
                    @if (!string.IsNullOrWhiteSpace(entry.ToolInput))
                    {
                        <p class="text-sm text-muted-foreground">@entry.ToolInput</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.ToolOutput))
                    {
                        <Markdown Text="@entry.ToolOutput" />
                    }
                    else if (entry.Status == StepStatus.Running)
                    {
                        <p class="font-mono text-xs text-muted-foreground/80">still working…</p>
                    }
                </Extra>
            </AiTask>
        }
        else if (entry.Kind == LogKind.Unrecognized)
        {
            // An unknown event that arrived mid-step keeps the turn's order but never
            // announces the renderer's gap.
            var known = ToolPresentation.ForEvent(entry);
            <AiTool @key="entry.Raw" Icon="@known.Icon" Title="@known.Title" Detail="@known.Detail" />
        }
        else
        {
            var rowView = ToolPresentation.For(entry, _outputTab == PrimaryTab);
            <AiTool @key="entry.Raw"
                    Icon="@rowView.Icon"
                    Title="@rowView.Title"
                    Description="@rowView.Description"
                    Status="@rowView.Status"
                    Detail="@rowView.Detail"
                    Command="@rowView.Command"
                    ExitCode="@rowView.ExitCode" />
        }
    </text>;

    /// <summary>The Trace status a turn's own state maps to, or null when it has settled.</summary>
    private static string? TurnTraceStatus(StepStatus status) => status switch
    {
        StepStatus.Running => "running",
        StepStatus.Failed => "error",
        _ => null,
    };

    private static string StepKey(StepStatus status) => status switch
    {
        StepStatus.Running => "running",
        StepStatus.Failed => "error",
        _ => "done",
    };

    /// <summary>
    /// The subagents a turn handed work to, when there were at least two. A single delegate
    /// is one row, not a plan; two or more are a handoff and read as a plan.
    /// </summary>
    private static IReadOnlyList<PlanStep> HandoffSteps(OutputItem item)
    {
        var agents = item.Entries.Where(entry => entry.Kind == LogKind.Subagent).ToArray();
        if (agents.Length < 2)
        {
            return Array.Empty<PlanStep>();
        }

        return agents
            .Select(entry => new PlanStep(AgentName(entry), StepKey(entry.Status)))
            .ToArray();
    }

    /// <summary>The agent a subagent entry names, or a neutral label.</summary>
    private static string AgentName(LogEntry entry) =>
        string.IsNullOrWhiteSpace(entry.Text) || entry.Text == "subagent" ? "subagent" : entry.Text;

    /// <summary>Web or MCP targets this turn reached, one per URL.</summary>
    private static IReadOnlyList<SourceLink> TurnSources(OutputItem item)
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var sources = new List<SourceLink>();

        foreach (var entry in item.Entries)
        {
            if (entry.Kind != LogKind.Tool || entry.Text is not ("webfetch" or "websearch"))
            {
                continue;
            }

            var match = UrlPattern.Match(entry.ToolInput ?? string.Empty);
            if (!match.Success || !seen.Add(match.Value))
            {
                continue;
            }

            sources.Add(new SourceLink(match.Value));
        }

        return sources;
    }

    private static readonly System.Text.RegularExpressions.Regex UrlPattern =
        new("https?://[^\\s\"'<>]+", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    // A step's cost line reads the same whether it hangs under a turn or stands alone, so
    // a footer marker keeps the turn footer's text; other markers keep their timestamp.
    private static string MarkerText(LogEntry entry) =>
        entry.Kind == LogKind.StepFinish || string.IsNullOrEmpty(entry.Timestamp)
            ? entry.Text
            : $"{entry.Timestamp} · {entry.Text}";

    private static string LineClass(string line)
    {
        if (line.Contains("ERROR", StringComparison.Ordinal))
        {
            return "err";
        }

        if (line.Contains("Revert", StringComparison.Ordinal) || line.Contains("Regression", StringComparison.Ordinal))
        {
            return "warn";
        }

        if (line.Contains("New best", StringComparison.Ordinal) || line.Contains("Completed", StringComparison.Ordinal))
        {
            return "ok";
        }

        if (line.Contains("$ ", StringComparison.Ordinal) || line.Contains("=====", StringComparison.Ordinal))
        {
            return "cmd";
        }

        return string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        _run = Run.State;
        _climb = Climber.State;
        Run.StateChanged += OnRunStateChanged;
        Climber.StateChanged += OnClimbStateChanged;

        _ = WatchClockAsync(_clockCts.Token);

        ResetProvider();

        if (string.IsNullOrWhiteSpace(_folderPath))
        {
            _folderPath = DefaultFolder;
        }

        ResolveAgents();
        RebuildEntries();
        await RefreshProviderSurfacesAsync();
    }

    /// <summary>
    /// Repaints once a second while a run is active so the elapsed clocks advance even
    /// when the stream is quiet. Output lines already drive their own renders; this only
    /// fills the gaps between them.
    /// </summary>
    private async Task WatchClockAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!AnyRunning)
                {
                    continue;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The page is gone.
        }
        catch (ObjectDisposedException)
        {
            // The circuit is gone.
        }
    }

    private void OnRunStateChanged(RunState state)
    {
        var wasActive = _run.Status is RunStatus.Running or RunStatus.AwaitingApproval;
        _run = state;
        RebuildEntries();
        Rerender();

        if (wasActive && IsTerminal(state.Status))
        {
            ResetProvider();
            _ = RefreshSpendAsync();
        }
    }

    private void OnClimbStateChanged(ClimberState state)
    {
        var wasActive = _climb.Status is RunStatus.Running or RunStatus.AwaitingApproval;
        _climb = state;
        RebuildEntries();
        Rerender();

        // The provider surfaces move once a run spends something; refresh when it finishes.
        if (wasActive && IsTerminal(state.Status))
        {
            ResetProvider();
            _ = RefreshSpendAsync();
        }
    }

    private static bool IsTerminal(RunStatus status) =>
        status is RunStatus.Completed or RunStatus.Failed or RunStatus.Stopped;

    /// <summary>A fallback approval applies to one run; the next start defaults to the primary again.</summary>
    private void ResetProvider()
    {
        _providerId = Providers.Primary?.Id ?? string.Empty;
        _pendingProviderApproval = false;
        _pendingProviderId = null;
        _startFallbackOffer = false;
        _startFallbackProviderId = null;
    }

    private void Rerender()
    {
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The circuit is gone; nothing left to update.
        }
    }

    private async Task RefreshSpendAsync()
    {
        await RefreshProviderSurfacesAsync();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The circuit is gone; nothing left to update.
        }
    }

    /// <summary>
    /// Refreshes every provider's catalogue and management-spend report. Providers with no
    /// API surface keep no report; the bar and the activity page describe them directly.
    /// </summary>
    private async Task RefreshProviderSurfacesAsync()
    {
        var catalogueLoads = Providers.Providers
            .Where(provider => provider.Catalogue is not null)
            .Select(async provider => (provider.Id, Report: await provider.Catalogue!.GetReportAsync()))
            .ToArray();
        var spendLoads = Providers.Providers
            .Where(provider => provider.Spend is not null)
            .Select(async provider => (provider.Id, Report: await provider.Spend!.GetSpendAsync()))
            .ToArray();

        // Apply the results after every probe finishes: the dictionaries are not thread-safe,
        // and the probes resume on the thread pool.
        foreach (var (id, report) in await Task.WhenAll(catalogueLoads))
        {
            _catalogueReports[id] = report;
        }

        foreach (var (id, report) in await Task.WhenAll(spendLoads))
        {
            _spendReports[id] = report;
        }
    }

    /// <summary>Reads the target folder's agents and the default one to run (config override + conventional default).</summary>
    private void ResolveAgents()
    {
        _agents = AgentCatalog.Resolve(_folderPath.Trim(), Config["Climber:DefaultAgent"], AgentCatalog.GlobalAgentsDirectory());
    }

    private void SetMethod(RunMethod method)
    {
        if (AnyRunning)
        {
            return;
        }

        _method = method;
        _error = null;
        _preflightWarnings = Array.Empty<string>();
        _startFallbackOffer = false;
        _startFallbackProviderId = null;
        _pendingProviderApproval = false;
        _pendingProviderId = null;
        _outputTab = PrimaryTab;
        RebuildEntries();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The box is disabled while a run is active, so focus waits for a render where it
        // is usable again — normally the one where the run settles.
        if (_prompt.TakeFocus(_unlocked, AnyRunning) && _promptInput is not null)
        {
            try
            {
                await _promptInput.Element.FocusAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException)
            {
                // Circuit gone, or the box left the page (the session re-locked mid-run).
            }
        }

        // A tab switch replaces the feed's rows, so its scroll position and open
        // disclosures live in script rather than in the DOM. Put them back only after
        // Blazor has patched the new tab in.
        if (_renderedTab != _outputTab && await RestoreTabAsync())
        {
            _renderedTab = _outputTab;
        }

        if (!firstRender)
        {
            return;
        }

        try
        {
            _sessionId = await JS.InvokeAsync<string>("climberAuth.sessionId");
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        _unlocked = Auth.IsUnlocked(_sessionId);
        _authChecked = true;

        _selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("climberAuth.start", _selfRef);
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-setup.
        }

        _expiryCts = new CancellationTokenSource();
        _ = WatchExpiryAsync(_expiryCts.Token);

        StateHasChanged();
    }

    private async Task WatchExpiryAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!_unlocked || _sessionId is null || Auth.IsUnlocked(_sessionId))
                {
                    continue;
                }

                await InvokeAsync(() =>
                {
                    _unlocked = false;
                    _pinInput = string.Empty;
                    _pinError = null;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    [JSInvokable]
    public void TouchActivity()
    {
        if (_unlocked && _sessionId is not null)
        {
            Auth.Touch(_sessionId);
        }
    }

    private void Unlock()
    {
        if (_sessionId is not null && Auth.TryUnlock(_sessionId, _pinInput))
        {
            _unlocked = true;
            _pinError = null;
            _pinInput = string.Empty;
        }
        else
        {
            _pinError = "Incorrect PIN.";
        }
    }

    private void Lock()
    {
        if (_sessionId is not null)
        {
            Auth.Lock(_sessionId);
        }

        _unlocked = false;
        _pinInput = string.Empty;
        _pinError = null;
    }

    private void OnPinKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Unlock();
        }
    }

    private void OpenBrowser()
    {
        var start = string.IsNullOrWhiteSpace(_folderPath) ? DefaultFolder : _folderPath.Trim();
        _browseListing = Browser.List(start);
        _browseOpen = true;
    }

    private void Navigate(string? path) => _browseListing = Browser.List(path);

    private void ChooseFolder()
    {
        if (_browseListing?.CurrentPath is { } chosen)
        {
            _folderPath = chosen;
            _browseOpen = false;
            ResolveAgents();
        }
    }

    private void CloseBrowser() => _browseOpen = false;

    private async Task Start()
    {
        _error = null;
        _preflightWarnings = Array.Empty<string>();
        _outputTab = PrimaryTab;

        var folder = _folderPath.Trim();
        var prompt = _prompt.Text.Trim();
        var preflight = Preflight.Check(folder, _method);
        if (!preflight.CanRun)
        {
            _error = preflight.Warnings.FirstOrDefault() ?? "The target folder is not usable.";
            return;
        }

        _preflightWarnings = preflight.Warnings;
        ResolveAgents();

        var provider = SelectedProvider;
        if (provider is null)
        {
            _error = "No provider is configured.";
            return;
        }

        if (provider.Catalogue is { } catalogue)
        {
            var report = await catalogue.GetReportAsync();
            _catalogueReports[provider.Id] = report;
            if (report is not { Reachable: true, ModelAvailable: true })
            {
                var next = Providers.FallbacksAfter(provider.Id).FirstOrDefault();
                if (next is null)
                {
                    _error = $"{provider.DisplayName} is not available ({report.StateLabel}).";
                    return;
                }

                _startFallbackProviderId = next.Id;
                _startFallbackMessage = report.Configured
                    ? $"{provider.DisplayName} is unavailable ({report.StateLabel}). Start this run on {next.DisplayName} instead?"
                    : $"{provider.DisplayName} is not configured. Start this run on {next.DisplayName} instead?";
                _startFallbackOffer = true;
                return;
            }
        }

        Launch(provider, folder, prompt);
    }

    /// <summary>Starts the selected method with an explicit provider. Never falls back silently.</summary>
    private void Launch(RegisteredProvider provider, string folder, string prompt)
    {
        var selection = ProviderSelection.From(provider, PricingFor(provider));
        var fallbacks = Providers.FallbacksAfter(provider.Id);

        // StartAsync throws synchronously for invalid input / concurrent runs and returns a
        // task that completes when the run finishes; we don't await it here. The box takes the
        // prompt only if that call succeeded, so a rejected launch keeps the text for a retry.
        // Clearing here — not in Start — keeps the provider fallback offer working, because
        // StartOnFallback re-enters Start and re-reads the box.
        var failure = _prompt.Launch(prompt, () =>
        {
            // A reader's turn choices belong to the transcript they were made in; the next
            // run starts with the defaults rather than inheriting keys that cannot recur.
            _turnOpen.Clear();

            if (_method == RunMethod.Hillclimb)
            {
                _ = Climber.StartAsync(new ClimberOptions(
                    folder, prompt, Math.Max(1, _maxIterations), _agents.DefaultAgent, selection, fallbacks));
            }
            else
            {
                _ = Run.StartAsync(new RunOptions(folder, prompt, _agents.DefaultAgent, selection, fallbacks));
            }
        });

        if (failure is not null)
        {
            _error = StripParameterSuffix(failure.Message);
        }
    }

    /// <summary>Puts the last started prompt back, for a re-run or a tweak.</summary>
    private void RecallLastPrompt() => _prompt.Recall();

    /// <summary>Catalogue pricing for a token estimate, when the provider publishes it.</summary>
    private ProviderPricing? PricingFor(RegisteredProvider provider) =>
        _catalogueReports.TryGetValue(provider.Id, out var report) ? report?.Pricing : null;

    private void SelectProvider(string providerId)
    {
        _startFallbackOffer = false;
        if (string.Equals(providerId, SelectedProviderId, StringComparison.OrdinalIgnoreCase))
        {
            _pendingProviderApproval = false;
            _pendingProviderId = null;
            return;
        }

        if (string.Equals(providerId, Providers.Primary?.Id, StringComparison.OrdinalIgnoreCase))
        {
            _pendingProviderApproval = false;
            _pendingProviderId = null;
            _providerId = providerId;
            return;
        }

        _pendingProviderApproval = true;
        _pendingProviderId = providerId;
    }

    private void ApproveProviderSwitch()
    {
        if (_pendingProviderId is { } id)
        {
            _providerId = id;
        }

        _pendingProviderApproval = false;
        _pendingProviderId = null;
        _startFallbackOffer = false;
    }

    private void CancelProviderSwitch()
    {
        _pendingProviderApproval = false;
        _pendingProviderId = null;
    }

    private Task StartOnFallback()
    {
        _startFallbackOffer = false;
        if (_startFallbackProviderId is { } id)
        {
            _providerId = id;
        }

        _startFallbackProviderId = null;
        _pendingProviderApproval = false;
        _pendingProviderId = null;
        return Start();
    }

    private void CancelStartFallback()
    {
        _startFallbackOffer = false;
        _startFallbackProviderId = null;
    }

    private void ApproveActiveFallback()
    {
        var nextId = ActiveFallback?.Id;
        try
        {
            if (_method == RunMethod.Run)
            {
                _ = Run.ApproveFallbackAsync();
            }
            else
            {
                Climber.ApproveFallback();
            }

            if (nextId is not null)
            {
                _providerId = nextId;
            }
        }
        catch (Exception ex)
        {
            _error = StripParameterSuffix(ex.Message);
        }
    }

    // ArgumentException messages end with a "(Parameter '...')" suffix that is noise
    // for the person at the dashboard; keep just the human-readable part.
    private static string StripParameterSuffix(string message)
    {
        const string marker = " (Parameter '";
        var index = message.LastIndexOf(marker, StringComparison.Ordinal);
        return index >= 0 && message.EndsWith("')", StringComparison.Ordinal)
            ? message[..index]
            : message;
    }

    private void Stop()
    {
        if (_method == RunMethod.Run)
        {
            Run.Stop();
        }
        else
        {
            Climber.Stop();
        }
    }

    public void Dispose()
    {
        Run.StateChanged -= OnRunStateChanged;
        Climber.StateChanged -= OnClimbStateChanged;
        _expiryCts?.Cancel();
        _expiryCts?.Dispose();
        _clockCts.Cancel();
        _clockCts.Dispose();
        _selfRef?.Dispose();
    }
}
