@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IRunService Run
@inject IHillClimberService Climber
@inject IConfiguration Config
@inject IFileBrowser Browser
@inject IClimberAuth Auth
@inject IProviderRegistry Providers
@inject IClimbPreflight Preflight
@inject IJSRuntime JS

<PageTitle>hillclimber</PageTitle>

@if (!_authChecked)
{
    <section class="panel auth">
        <div class="panel-head">
            <span class="idx">[00]</span>
            <span class="panel-title">session</span>
        </div>
        <p class="lede">Establishing session…</p>
    </section>
}
else if (!_unlocked)
{
    <section class="panel auth">
        <div class="panel-head">
            <span class="idx">[01]</span>
            <span class="panel-title">authenticate</span>
        </div>
        <p class="lede">Enter the access PIN to drive OpenCode.</p>

        <label class="label" for="pin">pin</label>
        <input id="pin"
               class="input"
               type="password"
               inputmode="numeric"
               autocomplete="off"
               @bind="_pinInput"
               @bind:event="oninput"
               @onkeydown="OnPinKeyDown" />

        @if (_pinError is not null)
        {
            <p class="notice notice-bad" role="alert">@_pinError</p>
        }

        <button class="btn btn-primary btn-wide auth-go" @onclick="Unlock">unlock →</button>
    </section>
}
else
{
    <section class="statusline" aria-live="polite">
        <span class="pulse pulse-@StatusKey" aria-hidden="true"></span>
        <span class="status-word st-@StatusKey">@StatusText</span>
        @if (ActiveMessage is not null)
        {
            <span class="status-msg">@ActiveMessage</span>
        }
    </section>

    <section class="methodbar" role="tablist" aria-label="method">
        <button class="method @(_method == RunMethod.Run ? "active" : string.Empty)"
                type="button" role="tab" aria-selected="@(_method == RunMethod.Run)"
                disabled="@AnyRunning" @onclick="() => SetMethod(RunMethod.Run)">run</button>
        <button class="method @(_method == RunMethod.Hillclimb ? "active" : string.Empty)"
                type="button" role="tab" aria-selected="@(_method == RunMethod.Hillclimb)"
                disabled="@AnyRunning" @onclick="() => SetMethod(RunMethod.Hillclimb)">hillclimb</button>
    </section>

    <section class="spendline" aria-label="Provider connections and spend">
        @foreach (var provider in Providers.Providers)
        {
            <span class="conn" data-provider="@provider.Id">
                <span class="dot dot-@ProviderTone(provider)" aria-hidden="true"></span>
                <span>@provider.DisplayName.ToLowerInvariant(): @ProviderLabel(provider)</span>
            </span>
            <span class="spend-sep" aria-hidden="true">/</span>
        }
        <span class="spend-item">@ActiveSpendNoun <b>@ActiveSpendText</b></span>
    </section>

    <section class="providerbar" aria-label="provider">
        <span class="label">provider</span>
        @foreach (var provider in Providers.Providers)
        {
            <button class="method @(SelectedProviderId == provider.Id ? "active" : string.Empty)"
                    type="button"
                    disabled="@AnyRunning"
                    aria-pressed="@(SelectedProviderId == provider.Id)"
                    @onclick="() => SelectProvider(provider.Id)">@provider.DisplayName.ToLowerInvariant()</button>
        }
        <span class="agent-note dim">@ProviderNote</span>
    </section>

    @if (_method == RunMethod.Run)
    {
        <dl class="telemetry" aria-label="Run telemetry">
            <div class="cell">
                <dt>status</dt>
                <dd class="st-@StatusKey">@StatusText</dd>
            </div>
            <div class="cell">
                <dt>spent</dt>
                <dd>@ActiveSpendText</dd>
            </div>
            <div class="cell">
                <dt>tokens</dt>
                <dd>@SpendFormat.Tokens(_run.Metrics.TotalTokens)</dd>
            </div>
            <div class="cell">
                <dt>elapsed</dt>
                <dd>@ElapsedLabel</dd>
            </div>
        </dl>
    }
    else
    {
        <dl class="telemetry" aria-label="Climb telemetry">
            <div class="cell">
                <dt>status</dt>
                <dd class="st-@StatusKey">@StatusText</dd>
            </div>
            <div class="cell">
                <dt>iteration</dt>
                <dd>
                    @if (_climb.MaxIterations > 0)
                    {
                        @_climb.CurrentIteration<span class="slash dim">/@_climb.MaxIterations</span>
                    }
                    else
                    {
                        <span class="dim">—</span>
                    }
                </dd>
            </div>
            <div class="cell">
                <dt>best score</dt>
                <dd>@_climb.BestScore</dd>
            </div>
            <div class="cell">
                <dt>last run</dt>
                <dd class="last">
                    @if (_climb.LastPassed is int passed)
                    {
                        <span class="g">@passed</span><span class="dim slash">/</span><span class="r">@_climb.LastFailed</span>
                    }
                    else
                    {
                        <span class="dim">—</span>
                    }
                </dd>
            </div>
        </dl>
    }

    <section class="panel">
        <div class="panel-head">
            <span class="idx">[02]</span>
            <span class="panel-title">configure</span>
        </div>

        <div class="field">
            <label class="label" for="folder">target folder</label>
            <div class="folder-row">
                <input id="folder"
                       class="input"
                       type="text"
                       placeholder="C:\path\to\your\repo"
                       disabled="@AnyRunning"
                       @bind="_folderPath"
                       @bind:after="ResolveAgents" />
                <button class="btn btn-ghost browse-btn" type="button" disabled="@AnyRunning" @onclick="OpenBrowser">browse</button>
            </div>
        </div>

        <div class="field">
            <label class="label" for="prompt">@PromptLabel</label>
            <textarea id="prompt"
                      class="input"
                      rows="3"
                      placeholder="@PromptPlaceholder"
                      disabled="@AnyRunning"
                      @bind="_prompt"></textarea>
        </div>

        @if (_method == RunMethod.Hillclimb)
        {
            <div class="field field-narrow">
                <label class="label" for="max">max iterations</label>
                <input id="max"
                       class="input"
                       type="number"
                       min="1"
                       disabled="@AnyRunning"
                       @bind="_maxIterations" />
            </div>
        }

        <div class="agent-line">
            <span class="label">@AgentLineLabel</span>
            @if (_agents.Roles.Count == 0)
            {
                <span class="chip mono">@AgentCatalog.WorkflowName</span>
            }
            else if (_method == RunMethod.Hillclimb)
            {
                @if (_agents.DefaultAgent is not null)
                {
                    <span class="chip mono chip-primary">@_agents.DefaultAgent</span>
                }
                @foreach (var role in Delegates)
                {
                    <span class="chip mono">@role.Name</span>
                }
            }
            else
            {
                <span class="chip mono chip-primary">@(_agents.DefaultAgent ?? AgentCatalog.WorkflowName)</span>
            }
            @if (AgentNote.Length > 0)
            {
                <span class="agent-note dim">@AgentNote</span>
            }
        </div>

        @if (_error is not null)
        {
            <p class="notice notice-bad" role="alert">@_error</p>
        }

        @foreach (var warning in _preflightWarnings)
        {
            <p class="notice notice-info" role="status">@warning</p>
        }

        @if (_pendingProviderApproval && PendingProvider is { } pending)
        {
            <p class="notice notice-info" role="status">
                @pending.DisplayName is a fallback and bills its own account. Approve it for this run?
            </p>
            <div class="btn-row approval-row">
                <button class="btn btn-primary" type="button" @onclick="ApproveProviderSwitch">approve @pending.Id.ToLowerInvariant()</button>
                <button class="btn btn-ghost" type="button" @onclick="CancelProviderSwitch">cancel</button>
            </div>
        }

        @if (_startFallbackOffer && StartFallbackProvider is { } startFallback)
        {
            <p class="notice notice-bad" role="alert">@_startFallbackMessage</p>
            <div class="btn-row approval-row">
                <button class="btn btn-primary" type="button" @onclick="StartOnFallback">start on @startFallback.Id.ToLowerInvariant()</button>
                <button class="btn btn-ghost" type="button" @onclick="CancelStartFallback">cancel</button>
            </div>
        }

        @if (ActiveFallbackAvailable && ActiveFallback is { } fallback)
        {
            <p class="notice notice-bad" role="alert">@ActiveFallbackMessage</p>
            <div class="btn-row approval-row">
                <button class="btn btn-primary" type="button" @onclick="ApproveActiveFallback">
                    retry on @fallback.Id.ToLowerInvariant()
                </button>
            </div>
        }

        <div class="btn-row">
            <button class="btn btn-primary" disabled="@AnyRunning" @onclick="Start">start</button>
            <button class="btn btn-danger" disabled="@(!ActiveRunning)" @onclick="Stop">stop</button>
            <button class="btn btn-ghost" @onclick="Lock">lock</button>
        </div>
    </section>

    <section class="panel panel-flush">
        <div class="panel-head">
            <span class="idx">[03]</span>
            <span class="panel-title">output</span>
            <span class="panel-meta">@ActiveLogs.Count lines</span>
        </div>
        <div class="outtabs" role="tablist" aria-label="Output stream">
            <button class="outtab @(_outputTab == PrimaryTab ? "active" : string.Empty)" type="button"
                    role="tab" aria-selected="@(_outputTab == PrimaryTab)" @onclick="() => SelectOutputTab(PrimaryTab)">@PrimaryTabLabel</button>
            @foreach (var name in SubAgentNames)
            {
                <button class="outtab @(_outputTab == name ? "active" : string.Empty)" type="button"
                        role="tab" aria-selected="@(_outputTab == name)" @onclick="() => SelectOutputTab(name)">@SubLabel(name)</button>
            }
        </div>
        <div class="log" id="log-feed">
            @foreach (var entry in VisibleEntries)
            {
                var css = LineClass(entry.Raw);
                if (entry.Kind == LogKind.Plain)
                {
                    <div class="log-line @css">@entry.Raw</div>
                }
                else if (entry.Kind == LogKind.Subagent && _outputTab == PrimaryTab)
                {
                    <div class="log-line @css log-event log-subagent-ref">
                        <span class="log-time">@entry.Timestamp</span>
                        <span class="log-subagent-name">◆ @entry.Text</span>
                        <span class="dim">— see its tab</span>
                    </div>
                }
                else if (entry.Kind == LogKind.Subagent)
                {
                    <div class="log-line @css log-event log-subagent">
                        <span class="log-time">@entry.Timestamp</span>
                        <span class="log-subagent-name">◆ @entry.Text</span>
                        @if (!string.IsNullOrEmpty(entry.ToolInput))
                        {
                            <pre class="log-subagent-prompt dim">@entry.ToolInput</pre>
                        }
                        @if (!string.IsNullOrEmpty(entry.ToolOutput))
                        {
                            <pre class="log-tool-out">@entry.ToolOutput</pre>
                        }
                    </div>
                }
                else
                {
                    <div class="log-line @css log-event @KindClass(entry.Kind)">
                        <span class="log-time">@entry.Timestamp</span>
                        @if (entry.Kind == LogKind.Tool)
                        {
                            <span class="log-tool-name">⚙ @entry.Text</span>
                            @if (!string.IsNullOrEmpty(entry.ToolInput))
                            {
                                <span class="log-tool-input">@entry.ToolInput</span>
                            }
                            @if (!string.IsNullOrEmpty(entry.ToolOutput))
                            {
                                <pre class="log-tool-out">@entry.ToolOutput</pre>
                            }
                        }
                        else
                        {
                            <span class="log-text">@entry.Text</span>
                        }
                    </div>
                }
            }
            @if (VisibleEntries.Count == 0)
            {
                <div class="log-line dim">awaiting output…</div>
            }
        </div>
    </section>

    @if (_browseOpen && _browseListing is not null)
    {
        <div class="browser-backdrop" @onclick="CloseBrowser"></div>
        <section class="browser" role="dialog" aria-modal="true" aria-label="Select target folder">
            <div class="panel-head browser-head">
                <span class="idx">[04]</span>
                <span class="panel-title">select folder</span>
                <button class="icon-btn browser-x" type="button" @onclick="CloseBrowser" aria-label="Close">✕</button>
            </div>

            <div class="browser-roots">
                @foreach (var root in _browseListing.Roots)
                {
                    <button class="chip" type="button" @onclick="() => Navigate(root.FullPath)">@root.Name</button>
                }
            </div>

            <nav class="crumbs" aria-label="Breadcrumb">
                <button class="crumb" type="button" @onclick="() => Navigate(null)">computer</button>
                @foreach (var crumb in _browseListing.Trail)
                {
                    <span class="crumb-sep" aria-hidden="true">/</span>
                    <button class="crumb" type="button" @onclick="() => Navigate(crumb.FullPath)">@crumb.Name</button>
                }
            </nav>

            <div class="browser-list">
                @if (_browseListing.Error is not null)
                {
                    <p class="notice notice-bad">@_browseListing.Error</p>
                }

                @if (_browseListing.CurrentPath is not null)
                {
                    <button class="dir up" type="button" @onclick="() => Navigate(_browseListing.ParentPath)">
                        <span class="dir-name">..</span>
                    </button>
                }

                @foreach (var dir in _browseListing.Directories)
                {
                    <button class="dir" type="button" @onclick="() => Navigate(dir.FullPath)">
                        <span class="dir-name">@dir.Name</span>
                    </button>
                }

                @if (_browseListing.CurrentPath is not null
                     && _browseListing.Directories.Count == 0
                     && _browseListing.Error is null)
                {
                    <p class="empty">no subfolders</p>
                }
            </div>

            <div class="browser-foot">
                <span class="browser-current mono">@(_browseListing.CurrentPath ?? "this computer")</span>
                <div class="browser-actions">
                    <button class="btn btn-ghost" type="button" @onclick="CloseBrowser">cancel</button>
                    <button class="btn btn-primary" type="button"
                            disabled="@(_browseListing.CurrentPath is null)"
                            @onclick="ChooseFolder">use this folder</button>
                </div>
            </div>
        </section>
    }
}

@code {
    private readonly LogFormatter _logFormatter = new();
    private RunState _run = new();
    private ClimberState _climb = new();
    private RunMethod _method = RunMethod.Run;
    private string _folderPath = string.Empty;
    private string _prompt = string.Empty;
    private AgentSelection _agents = new(Array.Empty<WorkflowRole>(), null);
    private IReadOnlyList<LogEntry> _entries = Array.Empty<LogEntry>();
    private string _outputTab = PrimaryTab;
    private int _maxIterations = 5;
    private string _pinInput = string.Empty;
    private string? _pinError;
    private string? _error;
    private bool _unlocked;
    private bool _browseOpen;
    private DirectoryListing? _browseListing;
    private bool _authChecked;
    private string? _sessionId;
    private DotNetObjectReference<Home>? _selfRef;
    private CancellationTokenSource? _expiryCts;
    private readonly Dictionary<string, ProviderReport?> _catalogueReports = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, SpendReport?> _spendReports = new(StringComparer.OrdinalIgnoreCase);
    private string _providerId = string.Empty;
    private bool _pendingProviderApproval;
    private string? _pendingProviderId;
    private bool _startFallbackOffer;
    private string _startFallbackMessage = string.Empty;
    private string? _startFallbackProviderId;
    private IReadOnlyList<string> _preflightWarnings = Array.Empty<string>();

    /// <summary>True while the method currently on screen is active (running or awaiting approval).</summary>
    private bool ActiveRunning => _method == RunMethod.Run
        ? _run.Status is RunStatus.Running or RunStatus.AwaitingApproval
        : _climb.Status is RunStatus.Running or RunStatus.AwaitingApproval;

    /// <summary>True while either method is active; the two share the machine, so only one may go at a time.</summary>
    private bool AnyRunning =>
        _run.Status is RunStatus.Running or RunStatus.AwaitingApproval
        || _climb.Status is RunStatus.Running or RunStatus.AwaitingApproval;

    private RunStatus ActiveStatus => _method == RunMethod.Run ? _run.Status : _climb.Status;

    private string? ActiveMessage => _method == RunMethod.Run ? _run.Message : _climb.Message;

    private IReadOnlyList<string> ActiveLogs => _method == RunMethod.Run ? _run.Logs : _climb.Logs;

    private decimal ActiveReportedSpendUsd => _method == RunMethod.Run ? _run.Metrics.SpendUsd : _climb.SpendUsd;

    private decimal ActiveEstimatedSpendUsd => _method == RunMethod.Run
        ? _run.Metrics.EstimatedSpendUsd
        : _climb.EstimatedSpendUsd;

    /// <summary>
    /// An estimated provider shows the token-based estimate, marked "est."; a reported
    /// provider keeps its exact cost. A mixed run shows both.
    /// </summary>
    private string ActiveSpendText =>
        SpendFormat.Spend((double)ActiveReportedSpendUsd, (double)ActiveEstimatedSpendUsd, ActiveProvider?.SpendMode ?? SpendMode.None);

    private ProviderSelection? ActiveProvider => _method == RunMethod.Run ? _run.Provider : _climb.Provider;

    private string ActiveSpendNoun => _method == RunMethod.Run ? "this run" : "this climb";

    private bool ActiveFallbackAvailable => _method == RunMethod.Run
        ? _run.FallbackAvailable
        : _climb.FallbackAvailable;

    private string? ActiveFallbackMessage => _method == RunMethod.Run
        ? _run.FallbackMessage
        : _climb.FallbackMessage;

    private string PromptLabel => _method == RunMethod.Run ? "prompt" : "goal prompt";

    private string PromptPlaceholder => _method == RunMethod.Run
        ? "What should this run do?"
        : "What should each iteration try to accomplish?";

    private string StatusKey => ActiveStatus.ToString().ToLowerInvariant();

    private string DefaultFolder =>
        Config["Climber:DefaultFolder"] is { Length: > 0 } folder
            ? folder
            : Environment.GetFolderPath(Environment.SpecialFolder.UserProfile) is { Length: > 0 } home
                ? home
                : Directory.GetCurrentDirectory();

    /// <summary>The provider selected in the bar; empty until the registry has been read.</summary>
    private string SelectedProviderId =>
        string.IsNullOrEmpty(_providerId) ? Providers.Primary?.Id ?? string.Empty : _providerId;

    private RegisteredProvider? SelectedProvider => Providers.Find(SelectedProviderId);

    private RegisteredProvider? PendingProvider =>
        _pendingProviderId is { } id ? Providers.Find(id) : null;

    private RegisteredProvider? StartFallbackProvider =>
        _startFallbackProviderId is { } id ? Providers.Find(id) : null;

    private ProviderSelection? ActiveFallback => _method == RunMethod.Run ? _run.Fallback : _climb.Fallback;

    /// <summary>Connection tone for a provider: catalogue first, then management spend.</summary>
    private string ProviderTone(RegisteredProvider provider) =>
        _catalogueReports.TryGetValue(provider.Id, out var catalogue) ? catalogue?.StateTone ?? "off"
        : _spendReports.TryGetValue(provider.Id, out var spend) ? spend?.Connection.StateTone ?? "off"
        : "off";

    /// <summary>Connection label for a provider, or a note for one opencode manages itself.</summary>
    private string ProviderLabel(RegisteredProvider provider) =>
        _catalogueReports.TryGetValue(provider.Id, out var catalogue) ? catalogue?.StateLabel ?? "checking…"
        : _spendReports.TryGetValue(provider.Id, out var spend) ? spend?.Connection.StateLabel ?? "checking…"
        : "opencode-managed";

    private string ProviderNote
    {
        get
        {
            var provider = SelectedProvider;
            if (provider is null)
            {
                return string.Empty;
            }

            var role = string.Equals(provider.Id, Providers.Primary?.Id, StringComparison.OrdinalIgnoreCase)
                ? "primary"
                : "fallback";
            var spend = provider.SpendMode switch
            {
                SpendMode.Estimated => "spend is estimated from tokens",
                SpendMode.Reported => "exact spend, approved for this run",
                _ => "no spend reporting",
            };
            return $"{role} — {spend}";
        }
    }

    private string AgentLineLabel => _method == RunMethod.Run ? "agent" : "agents";

    /// <summary>Agents other than the default, i.e. the ones the orchestrator may delegate to.</summary>
    private IReadOnlyList<WorkflowRole> Delegates => _agents.Roles
        .Where(role => !string.Equals(role.Name, _agents.DefaultAgent, StringComparison.OrdinalIgnoreCase))
        .ToArray();

    private string AgentNote => _agents.Roles.Count == 0
        ? string.Empty
        : _method == RunMethod.Run
            ? Delegates.Count == 0
                ? AgentCatalog.WorkflowName
                : $"{AgentCatalog.WorkflowName} — delegates to {string.Join(" / ", Delegates.Select(role => role.Name))} as needed"
            : $"{AgentCatalog.WorkflowName} — gated loop";

    private string ElapsedLabel
    {
        get
        {
            if (_run.StartedAt is not { } start)
            {
                return "—";
            }

            var span = (_run.FinishedAt ?? DateTimeOffset.Now) - start;
            return span.TotalMinutes >= 1
                ? $"{(int)span.TotalMinutes}m {span.Seconds:00}s"
                : $"{span.TotalSeconds:0.0}s";
        }
    }

    private string StatusText => ActiveStatus.Label();

    /// <summary>The tab that shows the combined stream; subagent tabs are keyed by agent id.</summary>
    private const string PrimaryTab = "primary";

    /// <summary>Friendly label for the primary tab: the running agent's name, or "Main" when none resolved.</summary>
    private string PrimaryTabLabel =>
        _agents.DefaultAgent is { Length: > 0 } agent ? RoleLabel(agent) : "Main";

    /// <summary>Friendly label for a subagent tab, from the resolved role or a title-cased id.</summary>
    private string SubLabel(string agentId) => RoleLabel(agentId);

    private string RoleLabel(string agentId) =>
        _agents.Roles.FirstOrDefault(role => string.Equals(role.Name, agentId, StringComparison.OrdinalIgnoreCase))?.DisplayName
        ?? WorkflowCatalogReader.DisplayName(agentId);

    /// <summary>Subagent names seen in this run, in first-seen order; one tab each.</summary>
    private IReadOnlyList<string> SubAgentNames => _entries
        .Where(entry => entry.Kind == LogKind.Subagent)
        .Select(entry => entry.Text)
        .Distinct(StringComparer.Ordinal)
        .ToArray();

    /// <summary>The entries for the selected tab: everything for the primary tab, one agent's calls otherwise.</summary>
    private IReadOnlyList<LogEntry> VisibleEntries => _outputTab == PrimaryTab
        ? _entries
        : _entries
            .Where(entry => entry.Kind == LogKind.Subagent && string.Equals(entry.Text, _outputTab, StringComparison.Ordinal))
            .ToArray();

    private void SelectOutputTab(string tab) => _outputTab = tab;

    private void RebuildEntries() => _entries = ActiveLogs.Reverse().Select(_logFormatter.Format).ToArray();

    /// <summary>CSS hook for a structured row; mirrors the kind names styled in Home.razor.css.</summary>
    private static string KindClass(LogKind kind) => kind switch
    {
        LogKind.Text => "log-text",
        LogKind.Tool => "log-tool",
        LogKind.StepStart => "log-step-start",
        LogKind.StepFinish => "log-step-finish",
        LogKind.Error => "log-error",
        _ => string.Empty,
    };

    private static string LineClass(string line)
    {
        if (line.Contains("ERROR", StringComparison.Ordinal))
        {
            return "err";
        }

        if (line.Contains("Revert", StringComparison.Ordinal) || line.Contains("Regression", StringComparison.Ordinal))
        {
            return "warn";
        }

        if (line.Contains("New best", StringComparison.Ordinal) || line.Contains("Completed", StringComparison.Ordinal))
        {
            return "ok";
        }

        if (line.Contains("$ ", StringComparison.Ordinal) || line.Contains("=====", StringComparison.Ordinal))
        {
            return "cmd";
        }

        return string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        _run = Run.State;
        _climb = Climber.State;
        Run.StateChanged += OnRunStateChanged;
        Climber.StateChanged += OnClimbStateChanged;

        ResetProvider();

        if (string.IsNullOrWhiteSpace(_folderPath))
        {
            _folderPath = DefaultFolder;
        }

        ResolveAgents();
        RebuildEntries();
        await RefreshProviderSurfacesAsync();
    }

    private void OnRunStateChanged(RunState state)
    {
        var wasActive = _run.Status is RunStatus.Running or RunStatus.AwaitingApproval;
        _run = state;
        RebuildEntries();
        Rerender();

        if (wasActive && IsTerminal(state.Status))
        {
            ResetProvider();
            _ = RefreshSpendAsync();
        }
    }

    private void OnClimbStateChanged(ClimberState state)
    {
        var wasActive = _climb.Status is RunStatus.Running or RunStatus.AwaitingApproval;
        _climb = state;
        RebuildEntries();
        Rerender();

        // The provider surfaces move once a run spends something; refresh when it finishes.
        if (wasActive && IsTerminal(state.Status))
        {
            ResetProvider();
            _ = RefreshSpendAsync();
        }
    }

    private static bool IsTerminal(RunStatus status) =>
        status is RunStatus.Completed or RunStatus.Failed or RunStatus.Stopped;

    /// <summary>A fallback approval applies to one run; the next start defaults to the primary again.</summary>
    private void ResetProvider()
    {
        _providerId = Providers.Primary?.Id ?? string.Empty;
        _pendingProviderApproval = false;
        _pendingProviderId = null;
        _startFallbackOffer = false;
        _startFallbackProviderId = null;
    }

    private void Rerender()
    {
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The circuit is gone; nothing left to update.
        }
    }

    private async Task RefreshSpendAsync()
    {
        await RefreshProviderSurfacesAsync();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The circuit is gone; nothing left to update.
        }
    }

    /// <summary>
    /// Refreshes every provider's catalogue and management-spend report. Providers with no
    /// API surface keep no report; the bar and the activity page describe them directly.
    /// </summary>
    private async Task RefreshProviderSurfacesAsync()
    {
        var loads = Providers.Providers.Select(async provider =>
        {
            if (provider.Catalogue is { } catalogue)
            {
                _catalogueReports[provider.Id] = await catalogue.GetReportAsync();
            }

            if (provider.Spend is { } spend)
            {
                _spendReports[provider.Id] = await spend.GetSpendAsync();
            }
        });

        await Task.WhenAll(loads);
    }

    /// <summary>Reads the target folder's agents and the default one to run (config override + conventional default).</summary>
    private void ResolveAgents()
    {
        _agents = AgentCatalog.Resolve(_folderPath.Trim(), Config["Climber:DefaultAgent"], AgentCatalog.GlobalAgentsDirectory());
    }

    private void SetMethod(RunMethod method)
    {
        if (AnyRunning)
        {
            return;
        }

        _method = method;
        _error = null;
        _preflightWarnings = Array.Empty<string>();
        _startFallbackOffer = false;
        _startFallbackProviderId = null;
        _pendingProviderApproval = false;
        _pendingProviderId = null;
        _outputTab = PrimaryTab;
        RebuildEntries();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _sessionId = await JS.InvokeAsync<string>("climberAuth.sessionId");
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        _unlocked = Auth.IsUnlocked(_sessionId);
        _authChecked = true;

        _selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("climberAuth.start", _selfRef);
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-setup.
        }

        _expiryCts = new CancellationTokenSource();
        _ = WatchExpiryAsync(_expiryCts.Token);

        StateHasChanged();
    }

    private async Task WatchExpiryAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!_unlocked || _sessionId is null || Auth.IsUnlocked(_sessionId))
                {
                    continue;
                }

                await InvokeAsync(() =>
                {
                    _unlocked = false;
                    _pinInput = string.Empty;
                    _pinError = null;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    [JSInvokable]
    public void TouchActivity()
    {
        if (_unlocked && _sessionId is not null)
        {
            Auth.Touch(_sessionId);
        }
    }

    private void Unlock()
    {
        if (_sessionId is not null && Auth.TryUnlock(_sessionId, _pinInput))
        {
            _unlocked = true;
            _pinError = null;
            _pinInput = string.Empty;
        }
        else
        {
            _pinError = "Incorrect PIN.";
        }
    }

    private void Lock()
    {
        if (_sessionId is not null)
        {
            Auth.Lock(_sessionId);
        }

        _unlocked = false;
        _pinInput = string.Empty;
        _pinError = null;
    }

    private void OnPinKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Unlock();
        }
    }

    private void OpenBrowser()
    {
        var start = string.IsNullOrWhiteSpace(_folderPath) ? DefaultFolder : _folderPath.Trim();
        _browseListing = Browser.List(start);
        _browseOpen = true;
    }

    private void Navigate(string? path) => _browseListing = Browser.List(path);

    private void ChooseFolder()
    {
        if (_browseListing?.CurrentPath is { } chosen)
        {
            _folderPath = chosen;
            _browseOpen = false;
            ResolveAgents();
        }
    }

    private void CloseBrowser() => _browseOpen = false;

    private async Task Start()
    {
        _error = null;
        _preflightWarnings = Array.Empty<string>();
        _outputTab = PrimaryTab;

        var folder = _folderPath.Trim();
        var prompt = _prompt.Trim();
        var preflight = Preflight.Check(folder, _method);
        if (!preflight.CanRun)
        {
            _error = preflight.Warnings.FirstOrDefault() ?? "The target folder is not usable.";
            return;
        }

        _preflightWarnings = preflight.Warnings;
        ResolveAgents();

        var provider = SelectedProvider;
        if (provider is null)
        {
            _error = "No provider is configured.";
            return;
        }

        if (provider.Catalogue is { } catalogue)
        {
            var report = await catalogue.GetReportAsync();
            _catalogueReports[provider.Id] = report;
            if (report is not { Reachable: true, ModelAvailable: true })
            {
                var next = Providers.FallbacksAfter(provider.Id).FirstOrDefault();
                if (next is null)
                {
                    _error = $"{provider.DisplayName} is not available ({report.StateLabel}).";
                    return;
                }

                _startFallbackProviderId = next.Id;
                _startFallbackMessage = report.Configured
                    ? $"{provider.DisplayName} is unavailable ({report.StateLabel}). Start this run on {next.DisplayName} instead?"
                    : $"{provider.DisplayName} is not configured. Start this run on {next.DisplayName} instead?";
                _startFallbackOffer = true;
                return;
            }
        }

        Launch(provider, folder, prompt);
    }

    /// <summary>Starts the selected method with an explicit provider. Never falls back silently.</summary>
    private void Launch(RegisteredProvider provider, string folder, string prompt)
    {
        var selection = ProviderSelection.From(provider, PricingFor(provider));
        var fallbacks = Providers.FallbacksAfter(provider.Id);

        try
        {
            // StartAsync throws synchronously for invalid input / concurrent runs and returns a
            // task that completes when the run finishes; we don't await it here.
            if (_method == RunMethod.Hillclimb)
            {
                _ = Climber.StartAsync(new ClimberOptions(
                    folder, prompt, Math.Max(1, _maxIterations), _agents.DefaultAgent, selection, fallbacks));
            }
            else
            {
                _ = Run.StartAsync(new RunOptions(folder, prompt, _agents.DefaultAgent, selection, fallbacks));
            }
        }
        catch (Exception ex)
        {
            _error = StripParameterSuffix(ex.Message);
        }
    }

    /// <summary>Catalogue pricing for a token estimate, when the provider publishes it.</summary>
    private ProviderPricing? PricingFor(RegisteredProvider provider) =>
        _catalogueReports.TryGetValue(provider.Id, out var report) ? report?.Pricing : null;

    private void SelectProvider(string providerId)
    {
        _startFallbackOffer = false;
        if (string.Equals(providerId, SelectedProviderId, StringComparison.OrdinalIgnoreCase))
        {
            _pendingProviderApproval = false;
            _pendingProviderId = null;
            return;
        }

        if (string.Equals(providerId, Providers.Primary?.Id, StringComparison.OrdinalIgnoreCase))
        {
            _pendingProviderApproval = false;
            _pendingProviderId = null;
            _providerId = providerId;
            return;
        }

        _pendingProviderApproval = true;
        _pendingProviderId = providerId;
    }

    private void ApproveProviderSwitch()
    {
        if (_pendingProviderId is { } id)
        {
            _providerId = id;
        }

        _pendingProviderApproval = false;
        _pendingProviderId = null;
        _startFallbackOffer = false;
    }

    private void CancelProviderSwitch()
    {
        _pendingProviderApproval = false;
        _pendingProviderId = null;
    }

    private Task StartOnFallback()
    {
        _startFallbackOffer = false;
        if (_startFallbackProviderId is { } id)
        {
            _providerId = id;
        }

        _startFallbackProviderId = null;
        _pendingProviderApproval = false;
        _pendingProviderId = null;
        return Start();
    }

    private void CancelStartFallback()
    {
        _startFallbackOffer = false;
        _startFallbackProviderId = null;
    }

    private void ApproveActiveFallback()
    {
        var nextId = ActiveFallback?.Id;
        try
        {
            if (_method == RunMethod.Run)
            {
                _ = Run.ApproveFallbackAsync();
            }
            else
            {
                Climber.ApproveFallback();
            }

            if (nextId is not null)
            {
                _providerId = nextId;
            }
        }
        catch (Exception ex)
        {
            _error = StripParameterSuffix(ex.Message);
        }
    }

    // ArgumentException messages end with a "(Parameter '...')" suffix that is noise
    // for the person at the dashboard; keep just the human-readable part.
    private static string StripParameterSuffix(string message)
    {
        const string marker = " (Parameter '";
        var index = message.LastIndexOf(marker, StringComparison.Ordinal);
        return index >= 0 && message.EndsWith("')", StringComparison.Ordinal)
            ? message[..index]
            : message;
    }

    private void Stop()
    {
        if (_method == RunMethod.Run)
        {
            Run.Stop();
        }
        else
        {
            Climber.Stop();
        }
    }

    public void Dispose()
    {
        Run.StateChanged -= OnRunStateChanged;
        Climber.StateChanged -= OnClimbStateChanged;
        _expiryCts?.Cancel();
        _expiryCts?.Dispose();
        _selfRef?.Dispose();
    }
}
