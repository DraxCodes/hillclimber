@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IHillClimberService Climber
@inject IConfiguration Config

<PageTitle>hillclimber</PageTitle>

@if (!_unlocked)
{
    <section class="panel auth">
        <div class="panel-head">
            <span class="idx">[01]</span>
            <span class="panel-title">authenticate</span>
        </div>
        <p class="lede">Enter the access PIN to control the climb loop.</p>

        <label class="label" for="pin">pin</label>
        <input id="pin"
               class="input"
               type="password"
               inputmode="numeric"
               autocomplete="off"
               @bind="_pinInput"
               @bind:event="oninput"
               @onkeydown="OnPinKeyDown" />

        @if (_pinError is not null)
        {
            <p class="notice notice-bad" role="alert">@_pinError</p>
        }

        <button class="btn btn-primary btn-wide auth-go" @onclick="Unlock">unlock →</button>
    </section>
}
else
{
    <section class="statusline" aria-live="polite">
        <span class="pulse pulse-@StatusKey" aria-hidden="true"></span>
        <span class="status-word st-@StatusKey">@StatusText</span>
        @if (_state.Message is not null)
        {
            <span class="status-msg">@_state.Message</span>
        }
    </section>

    <dl class="telemetry" aria-label="Climb telemetry">
        <div class="cell">
            <dt>status</dt>
            <dd class="st-@StatusKey">@StatusText</dd>
        </div>
        <div class="cell">
            <dt>iteration</dt>
            <dd>@_state.CurrentIteration<span class="slash dim">/@_state.MaxIterations</span></dd>
        </div>
        <div class="cell">
            <dt>best score</dt>
            <dd>@_state.BestScore</dd>
        </div>
        <div class="cell">
            <dt>last run</dt>
            <dd class="last">
                @if (_state.LastPassed is int passed)
                {
                    <span class="g">@passed</span><span class="dim slash">/</span><span class="r">@_state.LastFailed</span>
                }
                else
                {
                    <span class="dim">—</span>
                }
            </dd>
        </div>
    </dl>

    <section class="panel">
        <div class="panel-head">
            <span class="idx">[02]</span>
            <span class="panel-title">configure</span>
        </div>

        <div class="field">
            <label class="label" for="folder">target folder</label>
            <input id="folder"
                   class="input"
                   type="text"
                   placeholder="C:\path\to\your\repo"
                   disabled="@IsRunning"
                   @bind="_folderPath" />
        </div>

        <div class="field">
            <label class="label" for="goal">goal prompt</label>
            <textarea id="goal"
                      class="input"
                      rows="3"
                      placeholder="What should each iteration try to accomplish?"
                      disabled="@IsRunning"
                      @bind="_goalPrompt"></textarea>
        </div>

        <div class="field field-narrow">
            <label class="label" for="max">max iterations</label>
            <input id="max"
                   class="input"
                   type="number"
                   min="1"
                   disabled="@IsRunning"
                   @bind="_maxIterations" />
        </div>

        @if (_error is not null)
        {
            <p class="notice notice-bad" role="alert">@_error</p>
        }

        <div class="btn-row">
            <button class="btn btn-primary" disabled="@IsRunning" @onclick="Start">start</button>
            <button class="btn btn-danger" disabled="@(!IsRunning)" @onclick="Stop">stop</button>
            <button class="btn btn-ghost" @onclick="Lock">lock</button>
        </div>
    </section>

    <section class="panel panel-flush">
        <div class="panel-head">
            <span class="idx">[03]</span>
            <span class="panel-title">output</span>
            <span class="panel-meta">@_state.Logs.Count lines</span>
        </div>
        <div class="log" id="log-feed">
            @foreach (var line in _state.Logs.Reverse())
            {
                <div class="log-line @LineClass(line)">@line</div>
            }
            @if (_state.Logs.Count == 0)
            {
                <div class="log-line dim">awaiting output…</div>
            }
        </div>
    </section>
}

@code {
    private ClimberState _state = new();
    private string _folderPath = string.Empty;
    private string _goalPrompt = string.Empty;
    private int _maxIterations = 5;
    private string _pinInput = string.Empty;
    private string? _pinError;
    private string? _error;
    private bool _unlocked;

    private bool IsRunning => _state.Status == ClimberStatus.Running;

    private string StatusKey => _state.Status.ToString().ToLowerInvariant();

    private static string ExpectedPin(IConfiguration config) =>
        config["Climber:Pin"] is { Length: > 0 } pin ? pin : "1234";

    private string StatusText => _state.Status switch
    {
        ClimberStatus.Idle => "idle",
        ClimberStatus.Running => "running",
        ClimberStatus.Completed => "completed",
        ClimberStatus.Stopped => "stopped",
        ClimberStatus.Failed => "failed",
        _ => _state.Status.ToString(),
    };

    private static string LineClass(string line)
    {
        if (line.Contains("ERROR", StringComparison.Ordinal))
        {
            return "err";
        }

        if (line.Contains("Revert", StringComparison.Ordinal) || line.Contains("Regression", StringComparison.Ordinal))
        {
            return "warn";
        }

        if (line.Contains("New best", StringComparison.Ordinal) || line.Contains("Completed", StringComparison.Ordinal))
        {
            return "ok";
        }

        if (line.Contains("$ ", StringComparison.Ordinal) || line.Contains("=====", StringComparison.Ordinal))
        {
            return "cmd";
        }

        return string.Empty;
    }

    protected override void OnInitialized()
    {
        _state = Climber.State;
        Climber.StateChanged += OnStateChanged;
    }

    private void OnStateChanged(ClimberState state)
    {
        _state = state;
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The circuit is gone; nothing left to update.
        }
    }

    private void Unlock()
    {
        if (string.Equals(_pinInput, ExpectedPin(Config), StringComparison.Ordinal))
        {
            _unlocked = true;
            _pinError = null;
            _pinInput = string.Empty;
        }
        else
        {
            _pinError = "Incorrect PIN.";
        }
    }

    private void Lock()
    {
        _unlocked = false;
        _pinInput = string.Empty;
        _pinError = null;
    }

    private void OnPinKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Unlock();
        }
    }

    private void Start()
    {
        _error = null;

        try
        {
            // StartAsync throws synchronously for invalid input / concurrent runs and
            // returns a task that completes when the loop finishes; we don't await it here.
            _ = Climber.StartAsync(new ClimberOptions(
                _folderPath.Trim(),
                _goalPrompt.Trim(),
                Math.Max(1, _maxIterations)));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Stop() => Climber.Stop();

    public void Dispose() => Climber.StateChanged -= OnStateChanged;
}
