@page "/activity"
@implements IDisposable
@inject IProviderRegistry Providers
@inject IRunService Run
@inject IHillClimberService Climber

<PageTitle>activity · hillclimber</PageTitle>

<AuthGate OnUnlocked="LoadAsync">
<div class="mx-auto flex w-full max-w-5xl flex-col gap-4 px-3 py-4 sm:px-4">
@if (!_loaded)
{
    <PagePanel Index="0" Title="activity">
        <Spinner>Checking providers…</Spinner>
    </PagePanel>
}
else
{
    <p class="max-w-prose text-sm text-muted-foreground">@Lede</p>

    @foreach (var note in Providers.Notes)
    {
        <Alert Tone="info" Icon="circle-alert">@note</Alert>
    }

    var panel = 0;
    @for (var i = 0; i < Providers.Providers.Count; i++)
    {
        var provider = Providers.Providers[i];
        var catalogue = CatalogueReport(provider.Id);
        var spend = SpendReportFor(provider.Id);
        <PagePanel Index="@(panel++)" Title="@PanelTitle(provider)" Meta="@(i == 0 ? "primary" : "fallback")">

            @if (catalogue is { } report)
            {
                <div class="conn-line flex-wrap">
                    <span class="dot dot-@report.StateTone" aria-hidden="true"></span>
                    <span class="conn-state">@report.StateLabel</span>
                    @if (report.Model is { } model)
                    {
                        <Badge Variant="outline" Class="font-mono">@model</Badge>
                    }
                </div>

                @if (report.Pricing is { } pricing)
                {
                    <div class="spend-row">
                        <div class="spend-stat">
                            <span class="spend-num">@SpendFormat.Usd(pricing.Prompt * 1_000_000)</span>
                            <span class="spend-lbl">input / Mtok</span>
                        </div>
                        <div class="spend-stat">
                            <span class="spend-num">@SpendFormat.Usd(pricing.Completion * 1_000_000)</span>
                            <span class="spend-lbl">output / Mtok</span>
                        </div>
                        <div class="spend-stat">
                            <span class="spend-num">@SpendFormat.Usd(pricing.CacheRead * 1_000_000)</span>
                            <span class="spend-lbl">cache read / Mtok</span>
                        </div>
                    </div>
                }
                else if (report.Message is { } message)
                {
                    <p class="font-mono text-[0.78rem] text-muted-foreground">@message</p>
                }

                @foreach (var note in report.Notes)
                {
                    <Alert Tone="info" Icon="circle-alert" Class="mt-2">@note</Alert>
                }

                <p class="mt-3 text-[0.74rem] leading-relaxed text-muted-foreground">
                    @provider.DisplayName prices tokens in its OpenAI-compatible catalogue, so its
                    figures are estimates from opencode's <code class="mono">step_finish</code> tokens
                    times catalogue pricing. Runs are not persisted.
                </p>
            }
            else if (spend is { } spendReport)
            {
                <div class="conn-line flex-wrap">
                    <span class="dot dot-@spendReport.Connection.StateTone" aria-hidden="true"></span>
                    <span class="conn-state">@spendReport.Connection.StateLabel</span>
                    @if (spendReport.Connection.IsFreeTier && spendReport.Connection.Connected)
                    {
                        <Badge Variant="secondary">free tier</Badge>
                    }
                </div>

                @if (spendReport.Connection.Connected)
                {
                    <div class="spend-row">
                        <div class="spend-stat">
                            <span class="spend-num">@SpendFormat.Usd(spendReport.Connection.Usage)</span>
                            <span class="spend-lbl">key spend</span>
                        </div>
                        <div class="spend-stat">
                            <span class="spend-num">@SpendFormat.Usd(spendReport.Connection.Limit)</span>
                            <span class="spend-lbl">key limit</span>
                        </div>
                        <div class="spend-stat">
                            <span class="spend-num">@SpendFormat.Usd(spendReport.Connection.LimitRemaining)</span>
                            <span class="spend-lbl">remaining</span>
                        </div>
                    </div>
                }
                else if (spendReport.Connection.Message is { } message)
                {
                    <p class="font-mono text-[0.78rem] text-muted-foreground">@message</p>
                }

                @foreach (var note in spendReport.Notes)
                {
                    <Alert Tone="info" Icon="circle-alert" Class="mt-2">@note</Alert>
                }
            }
            else
            {
                <p class="font-mono text-[0.78rem] text-muted-foreground">
                    @provider.DisplayName has no API surface configured; opencode runs it directly.
                </p>
            }
        </PagePanel>

        @if (spend is not null)
        {
            <PagePanel Index="@(panel++)" Title="@($"{provider.DisplayName.ToLowerInvariant()} account spend")">
                @if (spend.Account is { } account)
                {
                    <div class="spend-row">
                        <div class="spend-stat">
                            <span class="spend-num">@SpendFormat.Usd(account.TotalUsage)</span>
                            <span class="spend-lbl">total spent</span>
                        </div>
                        <div class="spend-stat">
                            <span class="spend-num">@SpendFormat.Usd(account.TotalCredits)</span>
                            <span class="spend-lbl">credits purchased</span>
                        </div>
                        <div class="spend-stat">
                            <span class="spend-num">@SpendFormat.Usd(account.Remaining)</span>
                            <span class="spend-lbl">remaining</span>
                        </div>
                    </div>
                }
                else
                {
                    <p class="font-mono text-[0.78rem] text-muted-foreground">Account total is unavailable — a management key is required.</p>
                }
            </PagePanel>
        }

        @if (spend is not null)
        {
            var daily = DailyFor(provider.Id);
            var models = ModelsFor(provider.Id);
            <PagePanel Index="@(panel++)" Title="@($"{provider.DisplayName.ToLowerInvariant()} activity")" Meta="@($"{daily.Count} day{(daily.Count == 1 ? "" : "s")}")">
                @if (daily.Count == 0)
                {
                    <p class="font-mono text-[0.78rem] text-muted-foreground">No activity in the last 30 days.</p>
                }
                else
                {
                    <div class="chart">
                        <svg viewBox="@($"0 0 {ChartWidth(daily)} {ChartHeight}")"
                             width="@ChartWidth(daily)" height="@ChartHeight"
                             preserveAspectRatio="xMidYMid meet"
                             role="img"
                             aria-label="@($"{provider.DisplayName} spend across {daily.Count} day(s)")">
                            <line class="axis" x1="0" y1="@Baseline" x2="@ChartWidth(daily)" y2="@Baseline" />
                            @for (var d = 0; d < daily.Count; d++)
                            {
                                var bucket = daily[d];
                                var barHeight = DailyMax(daily) == 0 ? 0 : bucket.Usage / DailyMax(daily) * (Baseline - TopPad);
                                var x = d * Step + BarGap;
                                var y = Baseline - barHeight;
                                <g class="bar-group">
                                    <title>@($"{bucket.Label}: {SpendFormat.Usd(bucket.Usage)}")</title>
                                    <rect class="bar" x="@x" y="@y" width="@BarWidth" height="@barHeight" rx="2" />
                                </g>
                            }
                        </svg>
                        <div class="chart-labels" style="@($"width: {ChartWidth(daily)}px")">
                            @for (var d = 0; d < daily.Count; d++)
                            {
                                <span class="chart-tick" style="@($"width: {Step}px")">@(ShowLabel(daily, d) ? daily[d].Label : string.Empty)</span>
                            }
                        </div>
                    </div>
                }
            </PagePanel>

            <PagePanel Index="@(panel++)" Title="@($"{provider.DisplayName.ToLowerInvariant()} by model")" Meta="@($"{models.Count} models")" Flush>
                @if (models.Count == 0)
                {
                    <p class="px-4 py-3.5 font-mono text-[0.78rem] text-muted-foreground sm:px-5">No per-model activity.</p>
                }
                else
                {
                    <ul class="models">
                        @foreach (var model in models)
                        {
                            <li class="model">
                                <span class="model-name mono">@model.Model</span>
                                <span class="model-metric">@model.Requests req</span>
                                <span class="model-metric">@SpendFormat.Tokens(model.PromptTokens + model.CompletionTokens) tok</span>
                                <span class="model-cost mono">@SpendFormat.Usd(model.Usage)</span>
                            </li>
                        }
                    </ul>
                }
            </PagePanel>
        }
    }

    <PagePanel Index="@(panel++)" Title="this session">
        <div class="spend-row">
            <div class="spend-stat">
                <span class="spend-num">@SpendFormat.Usd((double)SessionEstimate)</span>
                <span class="spend-lbl">est. spent this session</span>
            </div>
            <div class="spend-stat">
                <span class="spend-num">@SpendFormat.Tokens(SessionTokens)</span>
                <span class="spend-lbl">tokens this session</span>
            </div>
        </div>
        <p class="mt-3 text-[0.74rem] leading-relaxed text-muted-foreground">
            Estimated from opencode's <code class="mono">step_finish</code> tokens times each
            provider's catalogue pricing. Runs are not persisted.
        </p>
    </PagePanel>

    <PagePanel Index="@(panel++)" Title="this climb" Meta="@ClimbStatusLabel">
        <div class="spend-row">
            <div class="spend-stat">
                <span class="spend-num">@ClimbSpendText</span>
                <span class="spend-lbl">spent this climb</span>
            </div>
            <div class="spend-stat">
                <span class="spend-num">@ClimbBest</span>
                <span class="spend-lbl">best score</span>
            </div>
        </div>
        <p class="mt-2 font-mono text-[0.72rem] text-muted-foreground">tokens: @ClimbTokens</p>
        <p class="mt-3 text-[0.74rem] leading-relaxed text-muted-foreground">
            Summed live from opencode's own <code class="mono">step_finish</code> events;
            estimated and reported figures are kept separate. Runs are not persisted, so this
            reflects the current/last run only.
        </p>
    </PagePanel>

    <PagePanel Index="@(panel++)" Title="saved with skills">
        <p class="font-mono text-[0.78rem] text-muted-foreground">Not measured.</p>
        <p class="mt-3 text-[0.74rem] leading-relaxed text-muted-foreground">
            There is no honest baseline for what the same work would have cost without the skills,
            so no number is invented here. Matches how <a class="text-accent-text underline underline-offset-2" href="/status">status</a> treats per-change model.
        </p>
    </PagePanel>
}
</div>
</AuthGate>

@code {
    private const int BarWidth = 18;
    private const int Step = 30;
    private const int BarGap = 3;
    private const int TopPad = 8;
    private const int Baseline = 96;
    private const int ChartHeight = 104;

    private readonly Dictionary<string, ProviderReport?> _catalogueReports = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, SpendReport?> _spendReports = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<DailySpend>> _daily = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<ModelSpend>> _models = new(StringComparer.OrdinalIgnoreCase);
    private bool _loaded;
    private RunState _run = new();
    private ClimberState _climb = new();

    /// <summary>Token-based estimate across the current/last run and climb.</summary>
    private decimal SessionEstimate => _run.Metrics.EstimatedSpendUsd + _climb.EstimatedSpendUsd;

    private long SessionTokens =>
        _run.Metrics.InputTokens + _run.Metrics.OutputTokens + _run.Metrics.CacheReadTokens + _run.Metrics.CacheWriteTokens
        + _climb.InputTokens + _climb.OutputTokens + _climb.CacheReadTokens + _climb.CacheWriteTokens;

    private string ClimbSpendText =>
        SpendFormat.Spend((double)_climb.SpendUsd, (double)_climb.EstimatedSpendUsd, _climb.Provider?.SpendMode ?? SpendMode.None);

    private int ClimbBest => _climb.BestScore;

    private string ClimbStatusLabel => _climb.Status.Label();

    private string ClimbTokens => $"{SpendFormat.Tokens(_climb.InputTokens)} in / {SpendFormat.Tokens(_climb.OutputTokens)} out";

    /// <summary>
    /// One sentence naming the configured order. The default two-provider setup keeps the
    /// original wording; extra providers are simply appended to the fallback list.
    /// </summary>
    private string Lede
    {
        get
        {
            if (Providers.Primary is not { } primary)
            {
                return "No provider is configured. Read-only.";
            }

            var fallbacks = Providers.Providers.Skip(1).Select(provider => provider.DisplayName).ToArray();
            if (fallbacks.Length == 0)
            {
                return $"{primary.DisplayName} is the primary provider. Read-only.";
            }

            var names = fallbacks.Length == 1
                ? $"{fallbacks[0]} is the approved fallback"
                : $"{string.Join(", ", fallbacks[..^1])} and {fallbacks[^1]} are approved fallbacks";
            return $"{primary.DisplayName} is the primary provider; {names}. Read-only.";
        }
    }

    private string PanelTitle(RegisteredProvider provider) =>
        provider.Spend is not null
            ? $"{provider.DisplayName.ToLowerInvariant()} connection"
            : provider.DisplayName.ToLowerInvariant();

    private ProviderReport? CatalogueReport(string id) =>
        _catalogueReports.TryGetValue(id, out var report) ? report : null;

    private SpendReport? SpendReportFor(string id) =>
        _spendReports.TryGetValue(id, out var report) ? report : null;

    private IReadOnlyList<DailySpend> DailyFor(string id) =>
        _daily.TryGetValue(id, out var days) ? days : Array.Empty<DailySpend>();

    private IReadOnlyList<ModelSpend> ModelsFor(string id) =>
        _models.TryGetValue(id, out var models) ? models : Array.Empty<ModelSpend>();

    private static int ChartWidth(IReadOnlyList<DailySpend> daily) =>
        Math.Max(1, daily.Count * Step + BarGap * 2);

    private static double DailyMax(IReadOnlyList<DailySpend> daily) =>
        daily.Count > 0 ? daily.Max(bucket => bucket.Usage) : 0d;

    protected override void OnInitialized()
    {
        _run = Run.State;
        _climb = Climber.State;
        Run.StateChanged += OnRunStateChanged;
        Climber.StateChanged += OnStateChanged;
    }

    private async Task LoadAsync()
    {
        var catalogueLoads = Providers.Providers
            .Where(provider => provider.Catalogue is not null)
            .Select(async provider => (provider.Id, Report: await provider.Catalogue!.GetReportAsync()))
            .ToArray();

        var spendLoads = Providers.Providers
            .Where(provider => provider.Spend is not null)
            .Select(async provider =>
            {
                var report = await provider.Spend!.GetSpendAsync();
                var (days, models) = Summarize(report.Activity);
                return (provider.Id, Report: report, Days: days, Models: models);
            })
            .ToArray();

        // Apply the results after every probe finishes: the dictionaries are not thread-safe,
        // and the probes resume on the thread pool.
        foreach (var (id, report) in await Task.WhenAll(catalogueLoads))
        {
            _catalogueReports[id] = report;
        }

        foreach (var (id, report, days, models) in await Task.WhenAll(spendLoads))
        {
            _spendReports[id] = report;
            _daily[id] = days;
            _models[id] = models;
        }

        _loaded = true;
    }

    private void OnRunStateChanged(RunState state)
    {
        _run = state;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged(ClimberState state)
    {
        _climb = state;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Aggregates rows into a contiguous daily series and a per-model rollup.</summary>
    private static (IReadOnlyList<DailySpend> Days, IReadOnlyList<ModelSpend> Models) Summarize(
        IReadOnlyList<ProviderActivityRow> rows)
    {
        if (rows.Count == 0)
        {
            return (Array.Empty<DailySpend>(), Array.Empty<ModelSpend>());
        }

        var byDay = rows.GroupBy(r => r.Date).OrderBy(g => g.Key)
            .Select(g => new DailySpend(g.Key, g.Key.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture), g.Sum(r => r.Usage)))
            .ToArray();

        var byModel = rows.GroupBy(r => r.Model)
            .Select(g => new ModelSpend(g.Key, g.Sum(r => r.Requests), g.Sum(r => r.PromptTokens), g.Sum(r => r.CompletionTokens), g.Sum(r => r.Usage)))
            .OrderByDescending(m => m.Usage)
            .ToArray();

        return (byDay, byModel);
    }

    private static bool ShowLabel(IReadOnlyList<DailySpend> daily, int index)
    {
        var every = Math.Max(1, (int)Math.Ceiling(daily.Count / 8d));
        return index % every == 0 || index == daily.Count - 1;
    }

    public void Dispose()
    {
        Run.StateChanged -= OnRunStateChanged;
        Climber.StateChanged -= OnStateChanged;
    }

    private sealed record DailySpend(DateOnly Date, string Label, double Usage);

    private sealed record ModelSpend(string Model, int Requests, long PromptTokens, long CompletionTokens, double Usage);
}
