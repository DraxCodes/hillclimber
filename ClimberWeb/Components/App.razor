<!DOCTYPE html>
<html lang="en" data-theme="light" data-theme-pref="system">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbfb" />
    <BasePath />
    <ResourcePreloader />
    <script>
        // Resolve and apply the theme before first paint to avoid a flash.
        (function () {
            try {
                var pref = localStorage.getItem("hillclimber-theme") || "system";
                var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
                var resolved = pref === "system" ? (dark ? "dark" : "light") : pref;
                var el = document.documentElement;
                el.setAttribute("data-theme", resolved);
                el.setAttribute("data-theme-pref", pref);
                var meta = document.querySelector('meta[name="theme-color"]');
                if (meta) meta.setAttribute("content", resolved === "dark" ? "#0c0c0c" : "#fbfbfb");
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ai.css"]" />
    <link rel="stylesheet" href="@Assets["ClimberWeb.styles.css"]" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Theme cycle: system -> light -> dark. Uses event delegation so it keeps
        // working across Blazor enhanced navigations.
        (function () {
            var order = ["system", "light", "dark"];
            var mq = window.matchMedia("(prefers-color-scheme: dark)");

            function pref() {
                try { return localStorage.getItem("hillclimber-theme") || "system"; }
                catch (e) { return "system"; }
            }

            function resolve(p) {
                return p === "system" ? (mq.matches ? "dark" : "light") : p;
            }

            function apply(p) {
                var resolved = resolve(p);
                var el = document.documentElement;
                el.setAttribute("data-theme-pref", p);
                el.setAttribute("data-theme", resolved);
                var meta = document.querySelector('meta[name="theme-color"]');
                if (meta) meta.setAttribute("content", resolved === "dark" ? "#0c0c0c" : "#fbfbfb");
                var icons = document.querySelectorAll("[data-theme-icon]");
                for (var i = 0; i < icons.length; i++) {
                    // <svg> has no reflected `hidden` IDL property, so toggle the
                    // attribute directly; app.css hides [hidden] with !important.
                    if (icons[i].getAttribute("data-theme-icon") === p) {
                        icons[i].removeAttribute("hidden");
                    } else {
                        icons[i].setAttribute("hidden", "");
                    }
                }
                var btn = document.getElementById("theme-toggle");
                if (btn) btn.setAttribute("aria-label", "Theme: " + p + " (activate to change)");
            }

            document.addEventListener("click", function (e) {
                var btn = e.target && e.target.closest ? e.target.closest("#theme-toggle") : null;
                if (!btn) return;
                var next = order[(order.indexOf(pref()) + 1) % order.length];
                try { localStorage.setItem("hillclimber-theme", next); } catch (err) { }
                apply(next);
            });

            mq.addEventListener("change", function () {
                if (pref() === "system") apply("system");
            });

            // Blazor's enhanced navigation patches the document, which overwrites the
            // <html> data-theme / data-theme-pref attributes with the server-rendered
            // defaults. Re-apply the stored preference whenever a navigation completes,
            // so the theme survives moving between pages (current and future).
            function reapply() { apply(pref()); }
            document.addEventListener("enhancedload", reapply);
            if (window.Blazor && typeof window.Blazor.addEventListener === "function") {
                window.Blazor.addEventListener("enhancedload", reapply);
            }

            apply(pref());
        })();
    </script>
    <script>
        // Session + activity heartbeat for the PIN gate. Keeps a stable id in
        // localStorage (so a refresh is not re-prompted) and pings the server on
        // user activity so the sliding idle timeout only expires when truly idle.
        window.climberAuth = (function () {
            var KEY = "hillclimber-session";
            var dotNet = null;
            var attached = false;
            var lastSent = 0;
            var THROTTLE = 30000;

            function sessionId() {
                var id = null;
                try { id = localStorage.getItem(KEY); } catch (e) { }
                if (!id) {
                    id = (window.crypto && crypto.randomUUID)
                        ? crypto.randomUUID()
                        : "s-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2);
                    try { localStorage.setItem(KEY, id); } catch (e) { }
                }
                return id;
            }

            function ping(force) {
                if (!dotNet) return;
                var now = Date.now();
                if (!force && now - lastSent < THROTTLE) return;
                lastSent = now;
                dotNet.invokeMethodAsync("TouchActivity").catch(function () { });
            }

            function attach() {
                if (attached) return;
                attached = true;
                ["pointerdown", "keydown", "wheel", "touchstart"].forEach(function (name) {
                    document.addEventListener(name, function () { ping(false); }, { passive: true });
                });
                document.addEventListener("scroll", function () { ping(false); }, { passive: true, capture: true });
                document.addEventListener("visibilitychange", function () {
                    if (document.visibilityState === "visible") ping(false);
                });
            }

            return {
                sessionId: sessionId,
                start: function (ref) { dotNet = ref; attach(); ping(true); }
            };
        })();
    </script>
    <script>
        // Transcript affordances: copy a command from a terminal card, and close the
        // disclosure the reader is in with Escape. Delegated so Blazor re-renders and
        // enhanced navigation do not unbind either behaviour.
        window.climberLog = (function () {
            function legacyCopy(text) {
                var area = document.createElement("textarea");
                area.value = text;
                area.setAttribute("readonly", "");
                area.style.position = "fixed";
                area.style.opacity = "0";
                document.body.appendChild(area);
                area.select();
                var copied = false;
                try { copied = document.execCommand("copy"); } catch (e) { }
                document.body.removeChild(area);
                return copied ? Promise.resolve() : Promise.reject(new Error("copy failed"));
            }

            // navigator.clipboard needs a secure context and may still reject (permission,
            // unfocused document), so fall back to the selection path instead of failing.
            function copyText(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    return navigator.clipboard.writeText(text).catch(function () {
                        return legacyCopy(text);
                    });
                }

                return legacyCopy(text);
            }

            document.addEventListener("click", function (e) {
                var button = e.target && e.target.closest ? e.target.closest("[data-copy]") : null;
                if (!button) return;
                e.preventDefault();
                var label = button.textContent;

                function flash(text, cls) {
                    button.textContent = text;
                    button.classList.add(cls);
                    setTimeout(function () {
                        button.textContent = label;
                        button.classList.remove(cls);
                    }, 1200);
                }

                copyText(button.getAttribute("data-copy") || "").then(function () {
                    flash("copied", "is-copied");
                }).catch(function () {
                    flash("failed", "is-failed");
                });
            });

            // Remember the most recently opened transcript disclosure so Escape has a target
            // even when focus sits on the page body. Other page dialogs keep their own keys.
            var lastOpened = null;

            // A toggle fires after the browser has already grown the row, so the summary's
            // position before the change is captured on the click (or Escape) that causes it.
            var anchorPending = null;

            function captureAnchor(summary) {
                var details = summary && summary.parentElement;
                if (!details || details.tagName !== "DETAILS") return;
                anchorPending = { details: details, top: summary.getBoundingClientRect().top };
            }

            // Keep the clicked summary under the reader's eye: shift the feed by however far
            // the summary moved, or align a block taller than the panel to the near edge.
            // The arithmetic mirrors StepScrollMath.Target; the unit tests own the clamps.
            function anchorDisclosure(details, beforeTop) {
                var feed = document.getElementById("log-feed");
                if (!feed || !feed.contains(details)) return;
                var summary = details.querySelector(":scope > summary");
                if (!summary) return;

                var feedRect = feed.getBoundingClientRect();
                var afterTop = summary.getBoundingClientRect().top;
                var body = details.querySelector(":scope > div");
                var bodyRect = details.open && body ? body.getBoundingClientRect() : null;
                var bodyHeight = bodyRect ? bodyRect.height : 0;
                var tall = details.open && bodyHeight > feedRect.height - 60;
                var delta = tall ? afterTop - feedRect.top : afterTop - beforeTop;

                if (details.open && !tall && bodyHeight > 0 && bodyRect.bottom > 0) {
                    var bodyBottomAfter = bodyRect.bottom - delta;
                    if (bodyBottomAfter > feedRect.bottom + 2) {
                        delta += bodyBottomAfter - feedRect.bottom;
                    }
                    var bodyTopAfter = bodyRect.top - delta;
                    if (bodyTopAfter < feedRect.top - 2) {
                        delta -= feedRect.top - bodyTopAfter;
                    }
                }

                var summaryAfter = afterTop - delta;
                if (summaryAfter < feedRect.top - 2) {
                    delta -= feedRect.top - summaryAfter;
                } else if (summaryAfter > feedRect.bottom + 2) {
                    delta += summaryAfter - feedRect.bottom;
                }

                if (Math.abs(delta) < 2) return;

                var max = Math.max(0, feed.scrollHeight - feed.clientHeight);
                var target = feed.scrollTop + delta;
                target = isSolo(feed)
                    ? Math.max(0, Math.min(max, target))
                    : Math.min(0, Math.max(-max, target));
                if (Math.abs(target - feed.scrollTop) < 0.5) return;

                var reduce = window.matchMedia
                    && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                feed.scrollTo({ top: target, behavior: reduce ? "auto" : "smooth" });
            }

            document.addEventListener("click", function (e) {
                var summary = e.target && e.target.closest ? e.target.closest("#log-feed summary") : null;
                if (summary) captureAnchor(summary);
            }, true);

            document.addEventListener("toggle", function (e) {
                var details = e.target;
                if (!details || details.tagName !== "DETAILS") return;
                if (!details.closest || !details.closest("#log-feed")) return;
                if (details.open) {
                    lastOpened = details;
                } else if (lastOpened === details) {
                    lastOpened = null;
                }
                if (anchorPending && anchorPending.details === details) {
                    var beforeTop = anchorPending.top;
                    anchorPending = null;
                    anchorDisclosure(details, beforeTop);
                }
                syncLatest();
            }, true);

            // The combined stream is column-reverse, so its live edge is scrollTop 0 and
            // engines disagree on the sign when scrolled back; compare the distance
            // instead. A solo tab reads top down, so its live edge is the bottom.
            function isSolo(feed) {
                return feed.classList.contains("solo");
            }

            function atLiveEdge(feed) {
                if (isSolo(feed)) {
                    return feed.scrollHeight - feed.scrollTop - feed.clientHeight <= 32;
                }

                return Math.abs(feed.scrollTop) <= 32;
            }

            function syncLatest() {
                var feed = document.getElementById("log-feed");
                var button = document.getElementById("log-latest");
                if (!feed || !button) return;
                if (atLiveEdge(feed)) {
                    button.setAttribute("hidden", "");
                } else {
                    button.removeAttribute("hidden");
                }
            }

            // Scroll does not bubble, so listen in the capture phase. Looking the feed up on
            // each event keeps this working across Blazor re-renders and tab switches.
            document.addEventListener("scroll", function (e) {
                if (e.target && e.target.id === "log-feed") syncLatest();
            }, true);

            document.addEventListener("click", function (e) {
                var button = e.target && e.target.closest ? e.target.closest("[data-latest]") : null;
                if (!button) return;
                var feed = document.getElementById("log-feed");
                if (!feed) return;
                feed.scrollTop = isSolo(feed) ? feed.scrollHeight : 0;
                syncLatest();
            });

            // Switching tabs swaps the whole row set, which would otherwise drop where the
            // reader was scrolled and every disclosure they had opened. Keep both per tab
            // here, then let the page put them back once Blazor has patched the DOM.
            var tabState = Object.create(null);

            // Oldest first. Rows are rendered newest first and new work is always added at
            // the chronological end, so this order is stable while a run grows.
            function transcriptDetails(feed) {
                return Array.prototype.slice.call(feed.querySelectorAll("details")).reverse();
            }

            function saveTabState() {
                var feed = document.getElementById("log-feed");
                if (!feed) return;
                var tab = feed.getAttribute("data-active-tab");
                if (!tab) return;
                tabState[tab] = {
                    scroll: feed.scrollTop,
                    open: transcriptDetails(feed).map(function (details) {
                        return details.open ? 1 : 0;
                    })
                };
            }

            function restoreTabState(tab) {
                var feed = document.getElementById("log-feed");
                if (!feed) return;
                var state = tabState[tab];
                if (state) {
                    var details = transcriptDetails(feed);
                    for (var i = 0; i < details.length && i < state.open.length; i++) {
                        if (state.open[i]) {
                            details[i].setAttribute("open", "");
                        } else {
                            details[i].removeAttribute("open");
                        }
                    }

                    feed.scrollTop = state.scroll;
                }

                syncLatest();
            }

            // Capture phase: read the tab being left before Blazor's own handler swaps the
            // feed to the new one.
            document.addEventListener("click", function (e) {
                var tab = e.target && e.target.closest ? e.target.closest("[data-outtab]") : null;
                if (tab) saveTabState();
            }, true);

            document.addEventListener("keydown", function (e) {
                if (e.key !== "Escape") return;
                var active = document.activeElement;
                var details = active && active.closest ? active.closest("#log-feed details[open]") : null;
                if (!details && lastOpened && lastOpened.open) details = lastOpened;
                if (!details) return;
                var closingSummary = details.querySelector(":scope > summary");
                if (closingSummary) captureAnchor(closingSummary);
                details.removeAttribute("open");
                var summary = details.querySelector("summary");
                if (summary) summary.focus();
            });

            return {
                restoreTab: restoreTabState
            };
        })();
    </script>
</body>

</html>
